fun fib(n) {
  if (n < 2) return n;
  return fib(n - 2) + fib(n - 1);
}

fun printf(fmt, args) {
    var args_i = 0;
    for(var i = 0; fmt[i]; i = i + 1) {
        if(fmt[i] == '{' and fmt[i+1] == '}') {
            put(args[args_i]);
            args_i = args_i + 1;
            i = i + 1;
        } else {
            put(fmt[i]);
        }
    }
    print "";
}

fun main() {
    con num = 28;
    con start = clock();
    con result = fib(num);
    con end = clock() - start;

    printf("fib({}) == {}, time: {} ms", [num, result, end]);
}

main();
